<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="rootStackPane"
           fx:controller="com.kuznetsov.dictionarypc.controller.WordbookGroupCreateController_New">

    <center>
        <GridPane hgap="10" vgap="10">
            <TextField fx:id="tfGroupName" editable="true" prefColumnCount="40"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="Имя группы" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="10">
            <Button fx:id="btnCreate" text="Создать" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        </HBox>
    </bottom>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</BorderPane>
